        "generate",
        "test"
      ]
    },
    {
      "pattern": "scripts/install.ts",
      "checks": [
        "install",
        "test"
      ]
    },
    {
      "pattern": "scripts/collect.ts",
      "checks": [
        "collect",
        "test"
      ]
    },
    {
      "pattern": "scripts/collect-encrypted.ts",
      "checks": [
        "collect",
        "test"
      ]
    },
    {
